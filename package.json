{
  "name": "mtc-game-prototype",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/sync_public_assets.mjs",
    "build": "tsc && vite build",
