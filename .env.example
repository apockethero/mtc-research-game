# ============================================================================
# MTC Research Game - Variables de Entorno de Ejemplo
# IMPORTANTE: Este archivo contiene únicamente nombres y descripciones de variables.
# NUNCA subas credenciales reales, claves de servicio ni contraseñas a Git.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. VARIABLES PÚBLICAS DEL CLIENTE (Vite Frontend)
# Estas variables son empaquetadas en la aplicación cliente. Solo deben contener
# la URL pública del proyecto y la clave 'anon' pública con permisos RLS estrictos.
# ----------------------------------------------------------------------------

# URL base del proyecto Supabase (ej. https://abcdefghijklm.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Clave anónima pública de Supabase (anon key) con RLS estricto habilitado
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# (Opcional) URL directa de la función de ingesta desplegada
# Si se omite, la app infiere: ${VITE_SUPABASE_URL}/functions/v1/submit-evaluation
VITE_INGESTION_FUNCTION_URL=https://your-project-ref.supabase.co/functions/v1/submit-evaluation


# ----------------------------------------------------------------------------
# 2. SECRETOS DE SERVIDOR (Supabase Edge Function y PostgreSQL)
# ¡ATENCIÓN! Las variables a continuación NUNCA deben incluir el prefijo VITE_.
# Deben configurarse EXCLUSIVAMENTE en los Secretos de Entorno de Supabase:
# Ejecutar: supabase secrets set NOMBRE_VARIABLE=valor
# ----------------------------------------------------------------------------

# Clave de Servicio Privada (Service Role Key): Otorga permisos administrativos a la función de servidor
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Proveedor de correo transaccional (Resend API Key para notificaciones al investigador)
# RESEND_API_KEY=your-resend-api-key-placeholder

# Correo electrónico institucional del investigador donde llegarán los avisos de nuevas evaluaciones
# RESEARCHER_NOTIFICATION_EMAIL=investigador.mtc@tu-institucion.edu

# URL pública de la aplicación para el enlace del correo hacia el panel de investigador
# ADMIN_DASHBOARD_URL=https://apockethero.github.io/mtc-research-game/

# Sal criptográfica para pseudo-anonimizar las direcciones IP de control de abuso
# IP_SALT=mtc_eval_crypto_salt_long_random_string_2026
